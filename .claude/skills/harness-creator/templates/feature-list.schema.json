{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "description": "Registro del estado de implementación de funcionalidades para desarrollo guiado por agentes",
  "type": "object",
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único de la funcionalidad (p. ej., feat-001)",
            "pattern": "^feat-\\d+$"
          },
          "name": {
            "type": "string",
            "description": "Nombre corto de la funcionalidad"
          },
          "description": {
            "type": "string",
            "description": "Qué hace esta funcionalidad"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs de funcionalidades que deben estar terminadas antes que esta"
          },
          "status": {
            "type": "string",
            "enum": ["not-started", "in-progress", "blocked", "done"],
            "description": "Estado actual de implementación"
          },
          "evidence": {
            "type": "string",
            "description": "Evidencia de verificación cuando el estado es 'done'"
          }
        },
        "required": ["id", "name", "description", "status"]
      }
    }
  },
  "required": ["features"]
}
